{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/gerar", "dest": "/api/gerar.js" },
    { "src": "/api/checkout", "dest": "/api/checkout.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  }
}
